[Unit]
Description=UAV ground station: forward raw wfb-ng video + target telemetry to viewer (laptop draws boxes)
After=network-online.target wifibroadcast@gs.service
Wants=network-online.target

[Service]
Type=simple
User=radxa
# Máy nhận: sửa /etc/default/uav-gs-forward (FWD_ARGS) rồi: sudo systemctl restart uav-gs-forward
EnvironmentFile=-/etc/default/uav-gs-forward
ExecStart=/usr/bin/python3 /home/radxa/uav-project/gs_forward.py $FWD_ARGS
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
