# Tham số cho gs_forward.py (service uav-gs-forward). Sửa xong: sudo systemctl restart uav-gs-forward
#
# --dest IP           máy xem cố định (lặp lại để gửi nhiều máy). Có thể bỏ trống nếu app trên máy xem
#                     TỰ ĐĂNG KÝ: gửi 1 gói UDP bất kỳ tới Radxa cổng 5599 mỗi ~1 s (đổi IP không cần sửa gì).
#                     Laptop cắm dây thẳng vào Radxa: --dest 192.168.50.2
# --video-out-port N  cổng nhận video RTP trên máy xem (mặc định 5600)
# --telem-out-port N  cổng nhận JSON toạ độ trên máy xem (mặc định 5700)
FWD_ARGS=""
